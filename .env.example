# Copy this file to .env only if you want to configure the optional live coach.
# Create a free key at https://openrouter.ai/keys and keep it on the server.
# Never put the key in app.js, index.html, or a mobile bundle.
AI_ENABLED=false
OPENROUTER_API_KEY=
# openrouter/free uses OpenRouter's free models at no cost; set a specific free
# model instead if you prefer. Free models have per-minute and daily limits.
OPENROUTER_MODEL=openrouter/free
# Comma-separated browser origins allowed to call the coach API. Defaults cover
# this repo's GitHub Pages origin, daylightt.me, and local development.
# ALLOWED_ORIGINS=https://verityhoangjacob67.github.io,https://daylightt.me
HOST=127.0.0.1
PORT=4173
